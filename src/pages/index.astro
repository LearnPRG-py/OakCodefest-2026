---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Countdown from "../components/Countdown.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PrizePodium from "../components/PrizePodium.astro";
import ContactSection from "../components/ContactSection.astro";
import { site, homeAbout, awards, homeContactFields } from "../lib/content";

const impactNumbers = [
  ["1,200+", "students"],
  ["Pan-India", "participation"],
  ["V10", "editions"],
  ["24 hours", "to build"],
];

const impactSkills = ["Collaboration", "Creativity", "Problem-solving", "Communication", "Leadership", "Resilience"];
const galleryImages = Array.from({ length: 15 }, (_, index) => index + 1);

---

<BaseLayout
  title="Oakridge Codefest 2027 | Home"
  description="Oakridge Codefest 2027 (v10): India's biggest overnight school-based hackathon. 5th–6th February 2027 at Oakridge International School, Bengaluru."
>
  <div id="depth-engine-root" class="pointer-events-none fixed inset-0 z-0" aria-hidden="true">
    <canvas id="ocean-canvas" class="absolute inset-0 h-full w-full"></canvas>
    <canvas id="scene-canvas" class="absolute inset-0 h-full w-full"></canvas>
  </div>

  <section id="home-hero" class="relative isolate flex min-h-dvh flex-col items-center justify-center overflow-hidden px-4 pt-32 pb-20 text-center sm:px-6">
    <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[80vmin] w-[80vmin] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>
    <p class="hero-date-pill mb-6 inline-flex font-mono text-xs uppercase tracking-[0.32em] text-foreground sm:text-sm" data-reveal-hero>
      <span>{site.eventDateLabel} · V10</span>
    </p>
    <h1 class="text-balance font-display text-6xl font-bold leading-[0.95] tracking-tight text-foreground sm:text-8xl xl:text-9xl" data-reveal-hero>
      The <span class="text-primary">LARGEST</span><br />overnight school-based <br class="sm:hidden" />hackathon<br />in India.
    </h1>
    <p class="mt-8 max-w-xl text-balance text-lg text-muted-foreground sm:text-xl" data-reveal-hero>{site.tagline}</p>
    <p class="mt-3 max-w-xl text-balance text-sm text-primary sm:text-base" data-reveal-hero>Celebrating 10 editions of student-led Codefest.</p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal-hero>
      <Button href="/coming-soon" variant="primary">Register your team</Button>
      <Button href="/about" variant="secondary" showArrow={false}>About Codefest</Button>
    </div>
    <div class="mt-16" data-reveal-hero>
      <p class="mb-4 font-mono text-xs uppercase tracking-widest text-muted-foreground">Begins In</p>
      <Countdown targetISO={site.countdownTargetISO} label={`Countdown to Oakridge Codefest 2027, ${site.eventDateLabel}`} />
    </div>
  </section>

  <section aria-label="Codefest impact numbers" class="relative border-y border-border bg-surface/30">
    <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-y divide-border sm:grid-cols-4 sm:divide-y-0">
      {impactNumbers.map(([number, label]) => (
        <div class="px-5 py-8 text-center sm:px-8" data-reveal>
          <p class="font-display text-3xl font-bold text-primary sm:text-4xl">{number}</p>
          <p class="mt-2 font-mono text-xs uppercase tracking-widest text-muted-foreground">{label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="relative border-t border-border py-20 sm:py-28">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-background/50"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="glass glass-glow grid grid-cols-1 gap-10 rounded-3xl p-6 sm:p-10 lg:grid-cols-5 lg:gap-12 lg:p-12">
        <img src="/brand/weareback.jpeg" alt="" class="aspect-[20/9] w-full rounded-2xl border border-border bg-black object-contain lg:order-last lg:col-span-2 lg:self-center" data-reveal />
        <div class="lg:col-span-3">
          <SectionHeading eyebrow="What is Codefest?" title={homeAbout.heading} class="mb-6" />
          <div class="space-y-4 text-base leading-relaxed text-foreground/85 sm:text-lg" data-reveal>
            {homeAbout.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="student-led" class="relative overflow-hidden border-t border-border py-24 sm:py-36">
    <div class="mx-auto grid max-w-7xl items-stretch gap-5 px-4 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:px-8">
      <div class="group relative min-h-[28rem] overflow-hidden rounded-3xl" data-reveal>
        <img src="/gallery/image-7.png" alt="Students at Codefest" class="absolute inset-0 h-full w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-background via-background/10 to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between">
          <p class="font-display text-3xl font-bold">Run the room.</p>
        </div>
      </div>
      <div class="glass flex flex-col justify-between rounded-3xl p-7 sm:p-10" data-reveal>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-primary">Student-led</p>
          <h2 class="mt-5 text-balance font-display text-4xl font-bold leading-tight sm:text-5xl">Students organise, build, manage and run Codefest.</h2>
          <p class="mt-6 text-lg leading-relaxed text-muted-foreground">The organising committee brings together technology, logistics, finance and marketing teams to run the event.</p>
        </div>
        <a href="/about" class="mt-10 inline-flex items-center font-mono text-sm text-primary transition hover:text-foreground">Meet the organising committee <span class="ml-2">↗</span></a>
      </div>
    </div>
  </section>

  <section id="impact" class="relative overflow-hidden border-t border-border bg-surface/25 px-4 py-24 sm:px-6 sm:py-36">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24">
      <SectionHeading eyebrow="Student impact" title="More than coding" description="Codefest develops skills that last beyond the event." />
      <div class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-border bg-border sm:grid-cols-3" data-reveal>
        {impactSkills.map((skill, index) => (
          <div class:list={["flex min-h-36 items-end bg-background p-5 transition duration-300 hover:bg-primary hover:text-on-primary sm:min-h-44 sm:p-6", index === 0 && "col-span-2 sm:col-span-1"]}>
            <div>
              <span class="font-mono text-xs text-primary/80">0{index + 1}</span>
              <p class="mt-8 font-display text-xl font-semibold">{skill}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="industry" class="relative overflow-hidden border-t border-border px-4 py-24 sm:px-6 sm:py-36">
    <div class="mx-auto grid max-w-7xl items-end gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-primary">Industry engagement</p>
        <h2 class="mt-5 text-balance font-display text-5xl font-bold leading-none sm:text-7xl">Bring your<br /><span class="text-primary">expertise.</span></h2>
        <p class="mt-7 max-w-md text-lg leading-relaxed text-muted-foreground">Professionals and organisations can engage through mentoring, judging, workshops, challenges and partnerships.</p>
        <Button href="mailto:codefest@oakridge.in" variant="secondary" class="mt-8">Talk to the team</Button>
      </div>
      <div class="relative grid grid-cols-2 gap-3 sm:grid-cols-3" data-reveal-group>
        {["Mentoring", "Judging", "Workshops", "Challenges", "Partnerships"].map((option, index) => (
          <div class:list={["glass group relative flex min-h-36 items-end overflow-hidden rounded-2xl p-5 transition duration-300 hover:-translate-y-2 hover:border-primary/60", index === 4 && "col-span-2 sm:col-span-1"]}>
            <span class="absolute -right-2 -top-7 font-display text-8xl font-bold text-primary/10 transition group-hover:text-primary/25">0{index + 1}</span>
            <span class="relative font-display text-lg font-semibold">{option}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="past-editions" class="relative overflow-hidden border-t border-border py-24 sm:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex items-end justify-between gap-4">
        <SectionHeading eyebrow="Past editions" title="A peek into our past" />
        <span class="hidden font-mono text-xs uppercase tracking-widest text-muted-foreground sm:block">Archive / 15 frames</span>
      </div>
      <div class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {galleryImages.map((image, index) => (
          <img
            src={`/gallery/image-${image}.png`}
            alt={`Codefest event moment ${index + 1}`}
            class:list={["aspect-[4/3] w-full rounded-2xl object-cover transition duration-500 hover:scale-[1.02]", index % 5 === 1 && "sm:translate-y-6", index % 5 === 3 && "lg:translate-y-10"]}
            loading="lazy"
            data-reveal
          />
        ))}
      </div>
    </div>
  </section>

  <section id="awards-chamber" class="relative overflow-hidden border-t border-border py-24 sm:py-32">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-background/60"></div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Awards" title={awards.heading} description={awards.subheading} align="center" class="mb-4" />
      <p class="text-shimmer mb-14 text-center font-display text-3xl font-bold sm:text-4xl" data-reveal>{awards.prizeHeadline}</p>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {awards.categories.map((cat) => <PrizePodium name={cat.name} podium={cat.podium} />)}
      </div>
    </div>
  </section>

  <section id="get-involved" class="border-t border-border px-4 py-20 text-center sm:px-6 sm:py-28">
    <SectionHeading eyebrow="V10" title="Be part of Codefest" description="Register your team or connect with the Codefest team." align="center" class="mx-auto mb-8" />
    <Button href="/coming-soon" variant="primary">Get involved</Button>
  </section>

  <ContactSection cardTitle="Codefest27.contact" fields={homeContactFields} />
  <script src="../three/homeDepth.ts"></script>
  <script src="../scripts/splash.ts"></script>
</BaseLayout>
