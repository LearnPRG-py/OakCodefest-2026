---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/content";
---

<BaseLayout
  title="Register | Oakridge Codefest 2027"
  description="Registration information for Oakridge Codefest 2027."
  showFooter={false}
>
  <section class="relative flex min-h-svh items-center overflow-hidden px-5 pb-12 pt-28 sm:px-8 sm:pt-32">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_75%_45%,rgba(116,192,201,0.1),transparent_50%)]" aria-hidden="true"></div>
    <div class="mx-auto grid w-full max-w-6xl items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-primary">Oakridge Codefest 2027 · {site.eventDateLabel}</p>
        <h1 class="mt-6 font-display text-6xl font-bold leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">Register<br />your team.</h1>
        <div class="mt-9 inline-flex rounded-full border border-primary/30 bg-primary/10 px-5 py-3 font-mono text-sm text-primary">
          Registration form coming soon
        </div>
      </div>

      <div class="glass glass-glow rounded-3xl p-6 sm:p-8">
        <h2 class="font-display text-2xl font-semibold">Before you register</h2>
        <dl class="mt-6 divide-y divide-border">
          <div class="py-5 first:pt-0">
            <dt class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Team size</dt>
            <dd class="mt-2 text-lg">2–6 members</dd>
          </div>
          <div class="py-5">
            <dt class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Who fills the form?</dt>
            <dd class="mt-2 text-lg">One person submits for the whole team.</dd>
          </div>
          <div class="py-5 last:pb-0">
            <dt class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Registration fee</dt>
            <dd class="mt-2 text-lg">₹1,800 per team</dd>
          </div>
        </dl>
        <p class="mt-6 text-sm text-muted-foreground">Registration form link coming soon.</p>
        <a href={`mailto:${site.email}`} class="mt-4 inline-block border-b border-primary/50 pb-1 font-mono text-sm text-primary transition hover:text-foreground">Questions? {site.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>
